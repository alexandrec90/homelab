# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every key here with a safe placeholder value.

# ---------------------------------------------------------------------------
# Worktree identity and host ports
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. It namespaces
# the stack's containers, network, and volumes, so a worktree running in parallel
# stays fully independent — and `scripts/docker_common.py`-style tooling filters
# `docker ps` by it.
COMPOSE_PROJECT_NAME=homelab

# This stack is run on a dedicated host, so the ports further down are each service's
# usual one rather than `conventional_base + slot`. Slot 8 in devkit's `ports.toml`
# only matters if you bring the stack up on the dev machine; check any port there
# first, 53 especially.

# ---------------------------------------------------------------------------
# Host
# ---------------------------------------------------------------------------
# Which groups this machine runs: any of media, cloud, dns, comma-separated.
COMPOSE_PROFILES=media,cloud,dns
# Everything the services write. Back this directory up.
DATA_ROOT=./data
# Your library, mounted read-only into Jellyfin and Plex.
MEDIA_ROOT=./media
# The host user that owns DATA_ROOT and MEDIA_ROOT (`id -u`, `id -g`).
PGID=1000
PUID=1000
TZ=America/New_York

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
JELLYFIN_HTTP_PORT=8096
# Plex: a one-time token from https://plex.tv/claim, read on first start only.
PLEX_ADVERTISE_URL=
PLEX_CLAIM=
PLEX_HTTP_PORT=32400

# ---------------------------------------------------------------------------
# Cloud
# ---------------------------------------------------------------------------
# The passwords here and under DNS are blank on purpose: the stack refuses to start until
# they are set. Compose reads the whole file, so that holds even for a profile this
# machine does not run. Generate each with `openssl rand -base64 24`.
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_DB_ROOT_PASSWORD=
NEXTCLOUD_HTTP_PORT=8080
# Space-separated hostnames or IPs people reach Nextcloud on.
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# ---------------------------------------------------------------------------
# DNS
# ---------------------------------------------------------------------------
PIHOLE_DNS_PORT=53
PIHOLE_HTTP_PORT=8053
PIHOLE_PASSWORD=

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=homelab
OTEL_RESOURCE_ATTRIBUTES=service.name=homelab,service.instance.id=homelab,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
