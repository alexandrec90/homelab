# The template for `.env`, which is gitignored. Create that with `python -m homelab init`,
# which generates every blank password and secret below. One `.env` serves every machine,
# and `python -m homelab rollout` copies it to them. A machine only needs the values for
# the stacks it runs.
#
# Paths, ids and addresses are not here: they come from `inventory.toml`.

# ---------------------------------------------------------------------------
# Worktree identity
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. `homelab` deploys always
# use the project name `homelab`; this line is for devkit's tooling.
COMPOSE_PROJECT_NAME=homelab

# ---------------------------------------------------------------------------
# Every machine
# ---------------------------------------------------------------------------
BACKUP_SERVER_PASSWORD=
# Encrypts the backups. Without it they cannot be restored: keep a copy off these machines.
RESTIC_PASSWORD=
TZ=America/New_York

# ---------------------------------------------------------------------------
# Generated secrets, one for each stack that uses them
# ---------------------------------------------------------------------------
IMMICH_DB_PASSWORD=
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_DB_ROOT_PASSWORD=
OPEN_WEBUI_SECRET=
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_SECRET_KEY=
PIHOLE_PASSWORD=

# ---------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
PAPERLESS_ADMIN_USER=admin
PAPERLESS_OCR_LANGUAGE=eng
# Semicolon-separated.
PIHOLE_UPSTREAMS=1.1.1.1;9.9.9.9
# Leave true until your account exists, then set false and deploy again.
VAULTWARDEN_SIGNUPS_ALLOWED=true

# ---------------------------------------------------------------------------
# Filled in by hand. Each comes from somewhere else, and an `optional` stack stays off
# until its values are set.
# ---------------------------------------------------------------------------
# From the Beszel hub, under Add System, once the `monitoring` stack is up.
BESZEL_KEY=
BESZEL_TOKEN=
# The repository the `ci` runner serves, and a token that may administer it.
GITHUB_RUNNER_REPO_URL=
GITHUB_RUNNER_TOKEN=
# Set to TRUE to accept https://aka.ms/MinecraftEULA and start the `minecraft` stack.
MINECRAFT_EULA=
# From https://plex.tv/claim just before the first start. It expires in minutes.
PLEX_CLAIM=
# A reusable key from the Tailscale admin console.
TAILSCALE_AUTHKEY=
VALHEIM_SERVER_NAME=Homelab
# At least five characters; setting it starts the `valheim` stack.
VALHEIM_SERVER_PASS=
VALHEIM_WORLD_NAME=Homelab

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=homelab
OTEL_RESOURCE_ATTRIBUTES=service.name=homelab,service.instance.id=homelab,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
